---
import Icon from "./Icon.astro";
import { address, email, footerNav, hours, links, logo, socials, whatsappLabel } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
  <div class="site-footer__grid">
    <div>
      <img
        class="logo-img logo-img--footer"
        src={logo.src}
        alt="Joriki Consultora"
        width={logo.width}
        height={logo.height}
      />
      <p class="site-footer__text">
        Desarrollo de mandos medios, dinámicas de equipo y liderazgo humano para organizaciones en transformación.
      </p>
      <div class="social">
        {
          socials.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
              <Icon name={item.icon} size="sm" />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <p class="eyebrow eyebrow--footer">Navegación</p>
      <ul class="site-footer__links">
        {
          footerNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="eyebrow eyebrow--footer">Contacto</p>
      <ul class="site-footer__links site-footer__links--contact">
        <li>
          <a class="contact-line" href={links.contact}>
            <Icon name="mail" size="sm" />
            <span>{email}</span>
          </a>
        </li>
        <li>
          <a class="contact-line" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
            <Icon name="phone" size="sm" />
            <span>{whatsappLabel}</span>
          </a>
        </li>
        <li class="contact-line">
          <Icon name="map-pin" size="sm" />
          <span>{address}</span>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow eyebrow--footer">Horario de atención</p>
      <ul class="site-footer__links">
        {
          hours.map(([day, time]) => (
            <li class="hours-row">
              <span>{day}</span>
              <span>{time}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="site-footer__legal">
    <p>Capacitaciones in-company y programas ejecutivos (presenciales y virtuales) · Joriki Consultora</p>
    <p>
      © {year} Martín Dicovsky ·{" "}
      <a href={links.designer} target="_blank" rel="noopener noreferrer">Diseñado por Patricio Baliña</a>
    </p>
  </div>
  </div>
</footer>
