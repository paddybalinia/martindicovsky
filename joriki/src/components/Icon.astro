---
import type { IconName } from "./icons";
import { icons } from "./icons";

interface Props {
  name: IconName;
  size?: "xs" | "sm" | "md";
}

const { name, size = "md" } = Astro.props;
const sizeClass = size === "xs" ? "icon icon--xs" : size === "sm" ? "icon icon--sm" : "icon";
---

<svg
  class={sizeClass}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
