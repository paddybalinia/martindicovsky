---
import Layout from "../layouts/Layout.astro";
import { linkTitles } from "../content/site";

const title = "Página no encontrada — Martín Dicovsky";
const description = "Esta página no existe. Volvé al inicio o recorré el coaching, las capacitaciones o el contacto.";
---

<Layout title={title} description={description} path="/404" noIndex>
  <div class="not-found">
    <div>
      <p class="not-found__code">404</p>
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace esté viejo o que la hayamos movido. Te dejo los caminos más útiles.</p>
      <div class="not-found__links">
        <a href="/" title={linkTitles.home}>Inicio</a>
        <a href="/coach-para-empaticos" title={linkTitles.coaching}>Coaching para empáticos</a>
        <a href="/capacitaciones" title={linkTitles.capacitaciones}>Capacitaciones</a>
        <a href="/contacto" title={linkTitles.contacto}>Contacto</a>
      </div>
    </div>
  </div>
</Layout>
